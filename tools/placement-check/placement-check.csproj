<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the mod's placement code outside the game: scouts JSON in, RAM writes JSON out. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../mod/LocationInfo.cs" />
    <Compile Include="../../mod/LocationData.g.cs" />
    <Compile Include="../../mod/ItemData.g.cs" />
    <Compile Include="../../mod/Placement.cs" />
    <Compile Include="../../mod/NetworkItem.cs" />
  </ItemGroup>
</Project>
