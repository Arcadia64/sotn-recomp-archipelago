<Project Sdk="Microsoft.NET.Sdk">
  <!-- Prints each overlay's dispatch-table function names from a built game's sotn.dll (a release
       download, say), one "overlay name" per line. Used by tools/check_hooks.py - -game DIR. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
