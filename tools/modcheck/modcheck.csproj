<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile-only check of mod/, with the same settings as the game's mod compiler (no implicit
       usings), against the game built in ref/SymphonyRecomp. Usage: dotnet build tools/modcheck -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameBin>$(MSBuildThisFileDirectory)../../ref/SymphonyRecomp/bin/Debug/net10.0</GameBin>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../mod/**/*.cs" />
    <Reference Include="$(GameBin)/sotn.dll" />
    <Reference Include="$(GameBin)/RecompOne.Runtime.dll" />
    <Reference Include="$(GameBin)/ImGui.NET.dll" />
  </ItemGroup>
</Project>
